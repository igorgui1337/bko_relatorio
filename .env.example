# Copie este arquivo para .env e preencha com suas credenciais.
# O .env real esta no .gitignore e nao sera versionado.
#
# Gmail: gere uma "Senha de app" em:
#   Conta Google > Seguranca > Verificacao em duas etapas > Senhas de app
#
# Outlook: use smtp.office365.com na porta 587

EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=seu@gmail.com
EMAIL_SMTP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_SMTP_FROM=seu@gmail.com
