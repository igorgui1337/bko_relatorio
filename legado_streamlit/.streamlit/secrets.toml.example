# Configuracao de e-mail para o Dashboard BKO
#
# Como usar:
#   1. Copie este arquivo para .streamlit/secrets.toml
#   2. Preencha com suas credenciais reais
#   3. O arquivo secrets.toml ja esta no .gitignore (nao sera versionado)
#
# Para Streamlit Cloud:
#   - Va em Settings > Secrets no painel do seu app
#   - Cole o conteudo abaixo (com suas credenciais preenchidas)
#
# Gmail: use uma "Senha de app" (nao a senha normal)
#   Acesse: Conta Google > Seguranca > Verificacao em duas etapas > Senhas de app
#
# Outlook / Office 365: use smtp.office365.com na porta 587

[email]
smtp_host     = "smtp.gmail.com"
smtp_port     = 587
smtp_user     = "seu@gmail.com"
smtp_password = "xxxx xxxx xxxx xxxx"   # senha de app do Gmail (16 chars)
smtp_from     = "seu@gmail.com"          # pode ser igual ao smtp_user
